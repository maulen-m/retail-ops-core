<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<false/>
	<key>Label</key>
	<string>com.example.kaspi-daily-ops-report</string>
	<key>ProgramArguments</key>
	<array>
		<string>__VENV_PYTHON__</string>
		<string>__RUN_KASPI_DAILY_OPS_REPORT_SCHEDULER__</string>
		<string>--profile</string>
		<string>catch-up</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>__RUNTIME_LOG_DIR__/kaspi_daily_ops_report_stderr.log</string>
	<key>StandardOutPath</key>
	<string>__RUNTIME_LOG_DIR__/kaspi_daily_ops_report_stdout.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>19</integer>
		<key>Minute</key>
		<integer>10</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>__PROJECT_ROOT__</string>
</dict>
</plist>
